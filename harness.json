{
  "version": 1,
  "project": "nosy",
  "executor": "claude",

  "workflow": {
    "tdd": "warn",
    "verify": "enforce"
  },

  "commands": {
    "packages/core": {
      "scaffoldMarker": "package.json",
      "sourceExt": ["ts"],
      "lint": "pnpm run lint",
      "build": "pnpm run build",
      "test": "pnpm run test -- {paths}"
    },
    "apps/pet": {
      "scaffoldMarker": "package.json",
      "sourceExt": ["ts", "tsx"],
      "lint": "pnpm run lint",
      "build": "pnpm run build",
      "test": "pnpm run test -- {paths}"
    }
  },

  "testPatterns": [],
  "tddExempt": [],
  "maxRetries": 3
}
